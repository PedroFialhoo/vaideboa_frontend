VITE_API_BASE_URL=http://localhost:8080
# URL HTTPS de um provedor que permita Referrer-Policy: no-referrer.
# Use os placeholders {z}, {x} e {y}. Nunca coloque uma chave secreta aqui.
VITE_MAP_TILE_URL=
# Atribuição exigida pelo provedor (HTML permitido; configure apenas conteúdo confiável).
VITE_MAP_ATTRIBUTION=

# Google Maps tem prioridade sobre os tiles Leaflet. Chave pública restrita por site.
GOOGLE_MAPS_API_KEY=
